{
  "name": "mahabharat-spaced-repetition",
  "version": "1.0.0",
  "description": "Mahabharat Vocabulary Spaced Repetition Application",
  "main": "src/app.ts",
  "scripts": {
    "start": "ts-node src/app.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test:full-gita": "node --test tests/full-gita.test.mjs",
    "test:avatars": "node --test tests/epic-avatars.test.mjs",
    "test:onboarding": "node --test tests/auth-onboarding.test.mjs",
    "test:otp-providers": "node --test tests/otp-providers.test.mjs",
    "test:security": "npm run build && node --test tests/security.test.mjs tests/security-integration.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^9.2.0",
    "mongoose": "^8.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
